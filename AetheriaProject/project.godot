; Godot Project Configuration for AETHERIA: Echoes of the Supreme
config_version=5

[application]

config/name="Aetheria: Echoes of the Supreme"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/textures/ui/icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
WorldManager="*res://scripts/core/world_manager.gd"
CombatSystem="*res://scripts/core/combat_system.gd"
MagicSystem="*res://scripts/core/magic_system.gd"
GambitController="*res://scripts/core/gambit_controller.gd"
BaseManager="*res://scripts/core/base_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

